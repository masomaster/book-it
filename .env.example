# MongoDB Atlas connection string (see README or Atlas: Connect → Drivers → Node.js)
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/book-it?retryWrites=true&w=majority

# Random string used to sign and verify login JWTs (not from a third-party service)
SECRET=replace-with-a-long-random-string

# Anthropic API key for Claude book recommendations (/api/books/getrecs)
CLAUDE_API_KEY=sk-ant-your-key-here

# Optional: Anthropic model ID (see https://platform.claude.com/docs/en/about-claude/models/overview )
# Fast/cheap: claude-haiku-4-5  or  pinned  claude-haiku-4-5-20251001
# Default in code if unset: claude-sonnet-4-20250514
# CLAUDE_MODEL=claude-haiku-4-5

# Google Books API key (Google Cloud → enable Books API → create API key). Used by /api/books/google-volumes for Add-a-Book search.
GOOGLE_BOOKS_API_KEY=

# Optional: run AdminJS locally on port 8000
# ENABLE_ADMINJS=true
